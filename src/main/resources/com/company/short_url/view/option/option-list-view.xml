<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      xmlns:c="http://jmix.io/schema/flowui/jpql-condition"
      title="msg://optionListView.title"
      focusComponent="optionsDataGrid">
    <data>
        <collection id="optionsDc"
                    class="com.company.short_url.entity.Option">
            <fetchPlan extends="_base"/>
            <loader id="optionsDl" readOnly="true">
                <query>
                    <![CDATA[select e from sh_Option e]]>
                </query>
            </loader>
        </collection>
    </data>
    <facets>
        <dataLoadCoordinator auto="true"/>
        <urlQueryParameters>
            <genericFilter component="genericFilter"/>
            <pagination component="pagination"/>
        </urlQueryParameters>
    </facets>
    <actions>
        <action id="selectAction" type="lookup_select"/>
        <action id="discardAction" type="lookup_discard"/>
    </actions>
    <layout>
        <genericFilter id="genericFilter"
                       dataLoader="optionsDl">
            <properties include=".*"/>
        </genericFilter>
        <hbox id="buttonsPanel" classNames="buttons-panel">
            <startSlot>
                <button id="createButton" action="optionsDataGrid.createAction"/>
                <button id="editButton" action="optionsDataGrid.editAction"/>
                <button id="removeButton" action="optionsDataGrid.removeAction"/>
            </startSlot>
            <endSlot>
                <simplePagination id="pagination" dataLoader="optionsDl"/>
            </endSlot>
        </hbox>
        <dataGrid id="optionsDataGrid"
                  width="100%"
                  minHeight="20em"
                  dataContainer="optionsDc"
                  columnReorderingAllowed="true">
            <actions>
                <action id="createAction" type="list_create"/>
                <action id="editAction" type="list_edit"/>
                <action id="removeAction" type="list_remove"/>
            </actions>
            <columns resizable="true">
                <column property="urlPathLength"/>
                <column property="shortenerUrl"/>
                <column property="linkLifeTime"/>
            </columns>
        </dataGrid>
        <hbox id="lookupActions" visible="false">
            <button id="selectButton" action="selectAction"/>
            <button id="discardButton" action="discardAction"/>
        </hbox>
    </layout>
</view>
