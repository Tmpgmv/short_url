<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      title="msg://shortUrlDetailView.title"
      focusComponent="form">
    <data>
        <instance id="shortUrlDc"
                  class="com.company.short_url.entity.ShortUrl">
            <fetchPlan extends="_base"/>
            <loader id="shortUrlDl"/>
        </instance>
    </data>
    <facets>
        <dataLoadCoordinator auto="true"/>
    </facets>
    <actions>
        <action id="saveCloseAction" type="detail_saveClose"/>
        <action id="closeAction" type="detail_close"/>
    </actions>
    <layout>
        <formLayout id="form" dataContainer="shortUrlDc">
            <responsiveSteps>
                <responsiveStep minWidth="0" columns="1"/>
                <responsiveStep minWidth="40em" columns="2"/>
            </responsiveSteps>
            <textField id="shortUrlField" property="shortUrl" enabled="false"/>
            <button id="copy" text="Копировать короткий URL"/>
            <dateTimePicker id="createdAtField" property="createdAt" enabled="false"/>
            <textField id="accessCountField" property="accessCount" enabled="false"/>
            <textField id="originalUrlField" property="originalUrl"/>
            <textArea id="commentField" property="comment"/>
            <textField id="redirectLimitField" property="redirectLimit"/>
            <dateTimePicker id="deadlineField" property="deadline" enabled="false"/>
            <textField id="idField" property="id" enabled="false"/>
            <textField id="deletedByField" property="deletedBy" enabled="false"/>
            <datePicker id="deletedDateField" property="deletedDate" enabled="false"/>
        </formLayout>
        <hbox id="detailActions">
            <button id="saveAndCloseButton" action="saveCloseAction"/>
            <button id="closeButton" action="closeAction"/>
        </hbox>
    </layout>
</view>
