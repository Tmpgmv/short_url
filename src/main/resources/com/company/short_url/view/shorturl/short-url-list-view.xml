<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      xmlns:c="http://jmix.io/schema/flowui/jpql-condition"
      title="msg://shortUrlListView.title"
      focusComponent="shortUrlsDataGrid">
    <data>
        <collection id="shortUrlsDc"
                    class="com.company.short_url.entity.ShortUrl">
            <fetchPlan extends="_base"/>
            <loader id="shortUrlsDl" readOnly="true">
                <query>
                    <![CDATA[select e from sh_ShortUrl e]]>
                </query>
            </loader>
        </collection>
    </data>
    <facets>
        <dataLoadCoordinator auto="true"/>
        <urlQueryParameters>
            <genericFilter component="genericFilter"/>
            <pagination component="pagination"/>
        </urlQueryParameters>
    </facets>
    <actions>
        <action id="selectAction" type="lookup_select"/>
        <action id="discardAction" type="lookup_discard"/>
    </actions>
    <layout>
        <genericFilter id="genericFilter"
                       dataLoader="shortUrlsDl">
            <properties include=".*"/>
        </genericFilter>
        <hbox id="buttonsPanel" classNames="buttons-panel">
            <startSlot>
                <button id="createButton" action="shortUrlsDataGrid.createAction"/>
                <button id="editButton" action="shortUrlsDataGrid.editAction"/>
                <button id="removeButton" action="shortUrlsDataGrid.removeAction"/>
            </startSlot>
            <endSlot>
                <simplePagination id="pagination" dataLoader="shortUrlsDl"/>
            </endSlot>
        </hbox>
        <dataGrid id="shortUrlsDataGrid"
                  width="100%"
                  minHeight="20em"
                  dataContainer="shortUrlsDc"
                  columnReorderingAllowed="true">
            <actions>
                <action id="createAction" type="list_create"/>
                <action id="editAction" type="list_edit"/>
                <action id="removeAction" type="list_remove"/>
            </actions>
            <columns resizable="true">
                <column property="shortUrl"/>
                <column property="createdAt"/>
                <column property="accessCount"/>
                <column property="originalUrl"/>
                <column property="deadline"/>
            </columns>
        </dataGrid>
        <hbox id="lookupActions" visible="false">
            <button id="selectButton" action="selectAction"/>
            <button id="discardButton" action="discardAction"/>
        </hbox>
    </layout>
</view>
